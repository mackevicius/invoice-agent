# Copy to `.env`; Compose reads it automatically. Never commit `.env`.

# Invoice reading: openai, anthropic, or fake (free, no key needed).
INVOICE_MODEL_PROVIDER=openai
INVOICE_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Fake mode: alternate reader response and scripted line choices (JSON).
INVOICE_FAKE_RESPONSE=
INVOICE_FAKE_LINE_CHOICES=

# Live model requests per UTC day; 0 disables live requests.
INVOICE_AI_DAILY_VISITOR_LIMIT=5
INVOICE_AI_DAILY_GLOBAL_LIMIT=100

# Optional Langfuse tracing. Keep the secret key out of the browser.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true

# Host ports.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=55432
